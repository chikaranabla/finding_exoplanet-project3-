    "# transit injection helpers\n",
    "import math\n",
    "\n",
    "def inject_box_transit(lc, epoch, period, duration_days, depth):\n",
    "    \"\"\"Injects a simple box-shaped transit into a lightcurve. Returns a new LightCurve.\"\"\"\n",
    "    time = lc.time.value\n",
    "    flux = lc.flux.copy()\n",
    "    phase = ((time - epoch + 0.5*period) % period) - 0.5*period\n",
    "    intransit = np.abs(phase) < (duration_days/2.0)\n",
    "    flux_inj = flux * (1.0 - depth * intransit.astype(float))\n",
    "    return LightCurve(time=time, flux=flux_inj, flux_err=getattr(lc, 'flux_err', None))\n",
    "\n",
    "# realistic injection via batman if available (https://lkreidberg.github.io/batman/docs/html/index.html)\n",
    "if HAVE_BATMAN:\n",
    "    def inject_batman(lc, t0, per, rp_rs, a_rs, inc_deg=90., u=[0.3,0.1]):\n",
    "        t = lc.time.value\n",
    "        params = batman.TransitParams()\n",
    "        params.t0 = t0\n",
    "        params.per = per\n",
    "        params.rp = rp_rs\n",
    "        params.a = a_rs\n",
    "        params.inc = inc_deg\n",
    "        params.ecc = 0.0\n",
    "        params.w = 90.0\n",
    "        params.u = u\n",
    "        params.limb_dark = 'quadratic'\n",
    "        m = batman.TransitModel(params, t)\n",
    "        model = m.light_curve(params)\n",
    "        flux_injected = lc.flux * model\n",
    "        return LightCurve(time=t, flux=flux_injected, flux_err=getattr(lc, 'flux_err', None))"
   ]
  },
  {
