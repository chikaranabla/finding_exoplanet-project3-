   "id": "796b0123-1ce4-450c-9e4f-abddf7f40cbb",
   "metadata": {},
   "outputs": [],
   "source": [
    "# setting up directories:\n",
    "BASE_DIR = os.getcwd()\n",
    "CACHE_MAP_FILE = os.path.join(BASE_DIR, 'host_kepid_map.json')\n",
    "\n",
    "# build star lists\n",
    "planet_hostnames = hosts['hostname'].dropna().unique().tolist()[:50]  # set limit here-> right now I have it at 50 hostnames of 4359\n",
    "all_kepids = pd.Series(stellar['kepid'].dropna().unique()).astype(int).values\n",
    "print(f\"Using {len(planet_hostnames)} hostnames (planet hosts)\")\n",
    "print(f\"Found {len(all_kepids)} unique Kepler IDs in stellar table\")\n",
    "\n",
    "# --------------------------------------\n",
    "# hostname -> KIC mapping\n",
    "def resolve_hostname_to_kepid(hostname):\n",
    "    try:\n",
    "        sr = lk.search_lightcurve(hostname, mission='Kepler')\n",
    "        if len(sr) == 0: return None\n",
    "        target = sr[0]\n",
    "        tn = target.target_name\n",
    "        if isinstance(tn, str) and 'KIC' in tn:\n",
    "            try: return int(''.join([c for c in tn if c.isdigit()]))\n",
    "            except: return None\n",
    "        try:\n",
    "            lcf = target.download()\n",
    "            hdr = lcf.hdu[0].header\n",
    "            for kname in ['KEPLERID','KIC','KEPID','KEP_ID']:\n",
    "                if kname in hdr: return int(hdr[kname])\n",
    "        except: return None\n",
    "    except: return None\n",
    "\n",
    "# --------------------------------------\n",
    "# load any existing cache-> basically any resolved hostnames are loaded from disk, not recomputed\n",
    "if os.path.exists(CACHE_MAP_FILE):\n",
    "    with open(CACHE_MAP_FILE, 'r') as f:\n",
    "        host_kepid_map = json.load(f)\n",
    "else:\n",
    "    host_kepid_map = {}\n",
    "\n",
    "failed_targets = []\n",
    "# --------------------------------------\n",
    "# resolving host names (skip already cached)\n",
    "for name in tqdm(planet_hostnames, desc='Resolving hostnames -> KIC'):\n",
    "    if name in host_kepid_map:\n",
    "        continue\n",
    "    k = resolve_hostname_to_kepid(name)\n",
    "    if k is not None:\n",
    "        host_kepid_map[name] = int(k)\n",
    "    else:\n",
    "        failed_targets.append(name)\n",
    "\n",
    "# save cache\n",
    "with open(CACHE_MAP_FILE, 'w') as f:\n",
    "    json.dump(host_kepid_map, f)\n",
    "\n",
    "print(f\"Resolved {len(host_kepid_map)} hostnames to KIC IDs\")\n",
    "print(f\"{len(failed_targets)} targets could not be resolved\")\n",
    "# --------------------------------------\n",
    "# building a balanced positive/negative candidate dataset\n",
    "positive_kepids = np.array(list(host_kepid_map.values()))\n",
    "neg_candidates = np.setdiff1d(all_kepids, positive_kepids)\n",
    "\n",
    "# optional implementation: limit for testing\n",
    "MAX_SAMPLE = 50  # NOTE: INCREASE LATER\n",
    "sample_size = min(len(positive_kepids), MAX_SAMPLE)\n",
    "if len(positive_kepids) > sample_size:\n",
    "    positive_kepids = np.random.choice(positive_kepids, sample_size, replace=False)\n",
    "negative_kepids = np.random.choice(neg_candidates, size=len(positive_kepids), replace=False)\n",
    "\n",
    "print(f\"Using {len(positive_kepids)} positives and {len(negative_kepids)} negatives for dataset\")"
   ]
