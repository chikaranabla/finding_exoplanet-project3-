   "source": [
    "# Bayesian-ready: per-quarter periodograms\n",
    "# basically for each lightcurve, this computes Lomb-Scargle periodograms per quarter\n",
    "# Linus correct me if I'm wrong but I thought this would help your Bayesian model detect periodic signals and assess per-quarter stability\n",
    "\n",
    "# save periodograms as numpy arrays (freq, power) in a folder per-kepid\n",
    "PERIOD_DIR = os.path.join(OUTDIR, 'per_quarter_periodograms')\n",
    "os.makedirs(PERIOD_DIR, exist_ok=True)\n",
    "\n",
    "for d in tqdm(dataset, desc='Saving per-quarter LS periodograms'):\n",
    "    kepid = d['kepid']\n",
    "    try:\n",
    "        # attempt to get full time & flux arrays per quarter\n",
    "        sr = lk.search_lightcurve(f'KIC {kepid}', mission='Kepler')\n",
    "        if len(sr) == 0:\n",
    "            continue\n",
    "        lc_collection = sr.download_all()\n",
    "        if lc_collection is None:\n",
    "            continue\n",
    "        # iterate each file (quarter) inside lc_collection\n",
    "        kep_dir = os.path.join(PERIOD_DIR, f'KIC_{kepid}')\n",
    "        os.makedirs(kep_dir, exist_ok=True)\n",
    "        for i, lcf in enumerate(lc_collection):\n",
    "            try:\n",
    "                lc_q = lcf.PDCSAP_FLUX\n",
    "                if lc_q is None:\n",
    "                    lc_q = lcf.SAP_FLUX\n",
    "                if lc_q is None:\n",
    "                    continue\n",
    "                t = lc_q.time.value\n",
    "                y = lc_q.flux.value\n",
    "                mask = ~np.isnan(t) & ~np.isnan(y)\n",
    "                if mask.sum() < 10:\n",
    "                    continue\n",
    "                t = t[mask]\n",
    "                y = y[mask]\n",
    "                # Lomb-Scargle\n",
    "                freq = np.linspace(0.01, 5.0, 2000)  # 0.2-100 day periods -> adjust\n",
    "                power = LombScargle(t, y).power(freq)\n",
    "                np.savez_compressed(os.path.join(kep_dir, f'quarter_{i}_periodogram.npz'), freq=freq, power=power)\n",
    "            except Exception:\n",
    "                continue\n",
    "    except Exception:\n",
    "        continue\n",
    "\n",
    "print('Saved per-quarter periodograms for Bayesian analysis')\n",
    "\n",
    "# saved files:\n",
    "print('Outputs saved in', OUTDIR)\n",
    "print('Files: dataset_metadata.csv, dataset_features.csv, cnn_dataset.npz, cnn_metadata.csv, cnn_model_example (if trained), examples/*, per_quarter_periodograms/*')"
   ]
  }
