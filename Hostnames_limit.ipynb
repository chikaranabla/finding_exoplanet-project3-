   "source": [
    "# CNN-ready formatting (phase-folded windows)\n",
    "# basically these are phase-folded lightcurve windows aligned to the BLS period\n",
    "# each sample will be binned to fixed length (NUM_BINS)\n",
    "# we'll save X (samples, bins) and y labels\n",
    "\n",
    "NUM_BINS = 200\n",
    "\n",
    "X = []\n",
    "Y = []\n",
    "meta = []\n",
    "\n",
    "for row in tqdm(feat_df.itertuples(index=False), desc='Preparing CNN arrays'):\n",
    "    kepid = int(row.kepid)\n",
    "    label = int(row.label)\n",
    "    bls_p = row.bls_period\n",
    "    # find dataset entry\n",
    "    entry = next((d for d in dataset if d['kepid']==kepid), None)\n",
    "    if entry is None:\n",
    "        continue\n",
    "    lc = entry['lc']\n",
    "    if np.isnan(bls_p) or bls_p <= 0:\n",
    "        # skip\n",
    "        continue\n",
    "    try:\n",
    "        folded = lc.fold(period=float(bls_p), epoch_time=lc.time.value[0])\n",
    "        # sort by phase\n",
    "        phase = (folded.time.value - folded.time.value.min())\n",
    "        # bin the folded lightcurve into NUM_BINS\n",
    "        bins = np.linspace(0, bls_p, NUM_BINS+1)\n",
    "        inds = np.digitize(folded.time.value, bins) - 1\n",
    "        binned_flux = np.zeros(NUM_BINS)\n",
    "        binned_counts = np.zeros(NUM_BINS)\n",
    "        for i, fval in enumerate(folded.flux.value):\n",
    "            idx = inds[i]\n",
    "            if 0 <= idx < NUM_BINS:\n",
    "                binned_flux[idx] += fval\n",
    "                binned_counts[idx] += 1\n",
    "        # avoid division by zero\n",
    "        nonzero = binned_counts > 0\n",
    "        binned_flux[nonzero] = binned_flux[nonzero] / binned_counts[nonzero]\n",
    "        # replace empty bins with interpolation or median\n",
    "        if not np.all(nonzero):\n",
    "            # simple interpolation for missing bins\n",
    "            import pandas as _pd\n",
    "            s = _pd.Series(binned_flux)\n",
    "            s = s.replace(0, np.nan).interpolate().fillna(method='bfill').fillna(method='ffill')\n",
    "            binned_flux = s.values\n",
    "        # normalize binned flux\n",
    "        binned_flux = (binned_flux - np.nanmedian(binned_flux)) / (np.nanstd(binned_flux) + 1e-12)\n",
    "        X.append(binned_flux.astype(np.float32))\n",
    "        Y.append(label)\n",
    "        meta.append({'kepid':kepid, 'bls_period':bls_p})\n",
    "    except Exception:\n",
    "        continue\n",
    "\n",
    "X = np.array(X)\n",
    "Y = np.array(Y)\n",
    "meta_df2 = pd.DataFrame(meta)\n",
    "print('Prepared CNN arrays:', X.shape, Y.shape)\n",
    "\n",
    "# save arrays\n",
    "np.savez_compressed(os.path.join(OUTDIR, 'cnn_dataset.npz'), X=X, Y=Y)\n",
    "meta_df2.to_csv(os.path.join(OUTDIR, 'cnn_metadata.csv'), index=False)\n",
    "print('Saved CNN arrays and metadata')"
   ]
  },
