   "source": [
    "# lightcurve download, cleaning, and caching\n",
    "from lightkurve import LightCurve\n",
    "\n",
    "def fetch_and_clean_kic(kepid, mission='Kepler', flatten_w=401, sigma_clip=5):\n",
    "    cache_file = os.path.join(CACHE_DIR, f'KIC_{kepid}.lc.pkl')\n",
    "    if os.path.exists(cache_file):\n",
    "        try:\n",
    "            with open(cache_file, 'rb') as f:\n",
    "                lc = pickle.load(f)\n",
    "                return lc\n",
    "        except: pass\n",
    "    try:\n",
    "        sr = lk.search_lightcurve(f'KIC {kepid}', mission=mission)\n",
    "        if len(sr) == 0: return None\n",
    "        lcf = sr.download()\n",
    "        if lcf is None: return None\n",
    "        try: lc = lcf.PDCSAP_FLUX\n",
    "        except: lc = lcf.SAP_FLUX\n",
    "        if lc is None: return None\n",
    "        lc = lc.remove_nans().remove_outliers(sigma=sigma_clip)\n",
    "        lc = lc.flatten(window_length=flatten_w).normalize()\n",
    "        try:\n",
    "            with open(cache_file, 'wb') as f:\n",
    "                pickle.dump(lc, f)\n",
    "        except: pass\n",
    "        return lc\n",
    "    except: return None\n",
    "\n",
    "dataset = []\n",
    "for kid in tqdm(positive_kepids, desc='Downloading positives'):\n",
    "    lc = fetch_and_clean_kic(kid)\n",
    "    if lc is not None: dataset.append({'id':kid,'kepid':int(kid),'lc':lc,'label':1})\n",
    "for kid in tqdm(negative_kepids, desc='Downloading negatives'):\n",
    "    lc = fetch_and_clean_kic(kid)\n",
    "    if lc is not None: dataset.append({'id':kid,'kepid':int(kid),'lc':lc,'label':0})\n",
    "\n",
    "print(f\"Final dataset size (successful downloads): {len(dataset)}\")\n",
    "\n",
    "# saving the metadata\n",
    "meta_df = pd.DataFrame([{'id':d['id'],'kepid':d['kepid'],'label':d['label']} for d in dataset])\n",
    "meta_df.to_csv(os.path.join(OUTDIR,'dataset_metadata.csv'), index=False)"
   ]
