 "source": [
  "# BATMAN PURELY SYNTHETIC DATA\n",
  "\n",
  "# This code generates a purely synthetic exoplanet transit light curve with BATMAN\n",
  "# For injecting into existing data, see the inject_batman() function in Isabella_Data_Cleaning\n",
  "\n",
  "import numpy as np\n",
  "import batman\n",
  "import matplotlib.pyplot as plt\n",
  "\n",
  "# Time array: 10 days sampled at 1000 points\n",
  "t = np.linspace(0, 10, 1000)\n",
  "\n",
  "# Transit parameters\n",
  "params = batman.TransitParams()\n",
  "params.t0 = 0.0                   # time of inferior conjunction [days]\n",
  "params.per = 1.0                  # orbital period [days]\n",
  "params.rp = 0.1                   # planet radius (in stellar radii)\n",
  "params.a = 15.0                   # semi-major axis (in stellar radii)\n",
  "params.inc = 87.0                 # orbital inclination [deg]\n",
  "params.ecc = 0.0                  # eccentricity\n",
  "params.w = 90.0                   # longitude of periastron [deg]\n",
  "params.limb_dark = \"nonlinear\"   # limb darkening law\n",
  "params.u = [0.5, 0.1, 0.1, -0.1] # limb darkening coefficients\n",
  "\n",
  "# Generate synthetic transit model\n",
  "m = batman.TransitModel(params, t)\n",
  "flux = m.light_curve(params)    # transit light curve\n",
  "\n",
  "# Add Gaussian noise for realism\n",
  "flux_noisy = flux + np.random.normal(0, 0.0005, size=flux.shape)\n",
  "\n",
  "# Plot the model and noisy data\n",
  "plt.figure(figsize=(10,6))\n",
  "plt.plot(t, flux_noisy, '.', label='Synthetic Data')\n",
  "plt.plot(t, flux, '-', label='BATMAN Model')\n",
  "plt.xlabel('Time [days]')\n",
  "plt.ylabel('Normalized Flux')\n",
  "plt.legend()\n",
  "plt.title('Synthetic BATMAN Transit Lightcurve')\n",
  "plt.show()\n"
 ]
}
